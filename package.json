{
  "name": "md-viewer-server",
  "version": "0.1.0",
  "description": "Background daemon serving a browser UI to view, search, and edit Markdown/HTML files over LAN",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "md-viewer-server": "./bin/cli.js"
  },
  "files": [
    "bin/**",
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:frontend": "vitest run --config vitest.frontend.config.ts tests/frontend",
    "lint": "eslint .",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.js",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^4.21.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "pino": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.6",
    "vitest": "^2.1.9"
  }
}
